# UniSmart Pay server settings.
# Copy to /etc/unismartpay/unismartpay.env and make it readable by root only:
#   sudo install -d -m 700 /etc/unismartpay
#   sudo install -m 600 deploy/unismartpay.env.example /etc/unismartpay/unismartpay.env
# Apache loads it at startup (see INSTALL.md), and the setup scripts read it too.

UNISMARTPAY_DB_HOST=127.0.0.1
UNISMARTPAY_DB_PORT=3306
UNISMARTPAY_DB_NAME=unismart_pay
UNISMARTPAY_DB_USER=unismart
UNISMARTPAY_DB_PASS=change-me

# Leave unset (or "prod") in production. "dev" shows error details to users.
#UNISMARTPAY_APP_ENV=prod
